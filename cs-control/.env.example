# Copie este arquivo para ".env" e preencha com os dados reais.
# NUNCA suba o arquivo ".env" para o Git nem para o servidor público.

# Banco de dados MySQL
DB_HOST=localhost
DB_NAME=cs_control
DB_USER=seu_usuario_mysql
DB_PASS=sua_senha_mysql

# Sessão
SESSION_NAME=cscontrol_session

# URL base da aplicação (usada em links de e-mail, se necessário)
APP_URL=http://localhost:8000

# --- Integrações (preenchidas nas próximas etapas) ---
